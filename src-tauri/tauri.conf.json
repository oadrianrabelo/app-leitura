{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sepia",
  "version": "../package.json",
  "identifier": "app.sepia.leitura",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sépia",
        "width": 1180,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Sua biblioteca e leitor pessoal",
    "publisher": "Sépia",
    "category": "Productivity"
  },
  "mainBinaryName": "sepia",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFN0ZENTQzREMwOEQ4NjkKUldScDJBamNROVYvRG92WVA2ZVJlelZBS1JGWE96R2srS1BoS2I1emZPWXpBWFhmT3BqUnhuZWIK",
      "endpoints": [
        "https://github.com/oadrianrabelo/app-leitura/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
